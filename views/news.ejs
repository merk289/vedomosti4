<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title><%= count %> новостей в категории <%= categoryTitle %></title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 2rem auto; }
    h3 { color: #2c3e50; }
    dt { font-weight: bold; margin-top: 1rem; }
    dd { margin-bottom: 1rem; color: #555; }
  </style>
</head>
<body>
  <h3><%= count %> последних новостей в категории <%= categoryTitle %></h3>
  <dl>
    <% items.forEach(function(item, index) { %>
      <dt><%= item.title %></dt>
      <dd><%= item.description %></dd>
    <% }); %>
  </dl>
</body>
</html>